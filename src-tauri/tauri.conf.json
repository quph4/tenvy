{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tenvy",
  "version": "../package.json",
  "identifier": "app.tenvy.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tenvy",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' http: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Tenvy",
    "copyright": "Copyright © 2026 Tenvy. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Tenvy – IPTV Player for Windows",
    "longDescription": "Tenvy is a fast IPTV player for Windows. Bring your own M3U or Xtream Codes playlist and get live TV with a full programme guide, movies and series with resume, library-wide search and watch history. Tenvy includes no channels or content.",
    "resources": {
      "resources/mpv/": "mpv/",
      "licenses/": "licenses/",
      "../LICENSE": "licenses/Tenvy-EULA.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwREE5NjQ3NURGREVFREUKUldUZTd2MWRSNWJhUURQU1B2azMrRmYyME5TbFhlWUE3TnZMK050aGVrMkpTQ0RrRXp3c29NVkoK",
      "endpoints": [
        "https://github.com/quph4/tenvy-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
