{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qanal",
  "version": "../package.json",
  "identifier": "app.qanal.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qanal",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' http: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Qanal",
    "copyright": "Copyright © 2026 Qanal. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Qanal – IPTV Player for Windows",
    "longDescription": "Qanal is a fast IPTV player for Windows. Bring your own M3U or Xtream Codes playlist and get live TV with a full programme guide, movies and series with resume, library-wide search and watch history. Qanal includes no channels or content.",
    "resources": {
      "resources/mpv/": "mpv/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwREE5NjQ3NURGREVFREUKUldUZTd2MWRSNWJhUURQU1B2azMrRmYyME5TbFhlWUE3TnZMK050aGVrMkpTQ0RrRXp3c29NVkoK",
      "endpoints": [
        "https://github.com/quph4/qanal-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
